# ToolBox environment
#
# The client-side release needs NO environment variables.
#
# Optional — set once the Cloudflare API (Phase 4) exists. When set,
# privacy-first tool events are beaconed to <URL>/api/v1/events.
# VITE_TOOLBOX_API_URL=https://api.yourdomain.com

# Build-time sitemap origin (scripts/generate-sitemap.ts).
# Override at build time:  SITE_URL=https://yourdomain.com npm run build
# SITE_URL=https://toolbox.example.com
